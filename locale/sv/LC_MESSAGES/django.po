#: results/templates/results/grouping_index.html:63
msgid "Pas assez de données pour calculer l'indice lièvre / suiveur."
msgstr "Inte tillräckligt med data för att beräkna hare-/följarindex."

#: results/templates/results/grouping_index.html:72
msgid ""
"L'<strong>indice lièvre / suiveur</strong> évalue les regroupements à "
"partir\n"
"  des heures absolues de passage aux postes.\n"
"  Une case <strong style=\"color:#1a6b3c\">verte</strong> indique un coureur "
"en\n"
"  tête de groupe (lièvre) ; une case <strong style=\"color:#c0392b\">rouge</"
"strong>\n"
"  un coureur qui en suit un autre (suiveur).\n"
"  Une case grise signifie que le coureur était seul sur ce tronçon.\n"
"  L'<strong>indice global</strong> est la moyenne pondérée par la durée de\n"
"  chaque tronçon."
msgstr ""
"Det <strong>hare-/följarindexet</strong> bedömer grupperingarna utifrån\n"
"  de absoluta paseringstiderna vid kontrollpunkterna.\n"
"  En ruta med <strong style='color:#1a6b3c'>grön</strong> färg indikerar en "
"tävlande som är\n"
"  gruppens hare; en ruta med <strong style='color:#c0392b'>röd</strong> färg "
"indikerar en\n"
"  tävlande som följer en annan (följare).\n"
"  En grå ruta betyder att tävlande var ensam på denna sträcka.\n"
"  Det <strong>totala indexet</strong> är det viktade genomsnittet efter\n"
"  varje sträckas längd."

