msgstr "Prestandaindex"

#: results/templates/results/performance.html:21
msgid "Pas assez de données pour calculer l'indice de performance."
msgstr "Inte tillräckligt med data för att beräkna prestandaindex."

#: results/templates/results/performance.html:27
#, python-format
msgid ""
"L'<strong>indice de performance</strong> d'un coureur sur un tronçon est la\n"
"  <strong>moyenne des 25%% meilleurs temps</strong> divisée par son propre "
"temps.\n"
"  Une valeur de <strong>1.0</strong> signifie qu'il court au niveau des "
"meilleurs.\n"
"  Une <strong>courbe haute et étroite</strong> indique une course "
"régulière ;\n"
"  une <strong>courbe étalée</strong> révèle des irrégularités entre les "
"tronçons.\n"
"  Chaque tronçon est <strong>pondéré par sa longueur</strong> (temps de "
"référence)."
msgstr ""
"Det <strong>prestandaindexet</strong> för en tävlande på en sträcka är\n"
"  <strong>genomsnittet av de 25%% bästa tiderna</strong> delat med dennes "
"egen tid.\n"
"  Ett värde på <strong>1.0</strong> betyder att tävlande springer i samma "
"klass som de bästa.\n"
"  En <strong>hög och smal kurva</strong> tyder på en jämn tävling;\n"
"  en <strong>bred kurva</strong> visar ojämnheter mellan sträckorna.\n"
"  Varje sträcka är <strong>viktad efter sin längd</strong> (referenstid)."

